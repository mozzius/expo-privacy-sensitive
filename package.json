{
  "name": "expo-privacy-sensitive",
  "version": "0.2.0",
  "description": "Hide a view in screenshots",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "expo-module test",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "open:ios": "xed example/ios",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "expo",
    "privacy",
    "screenshot",
    "screen-capture",
    "secure",
    "ios"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "download"
    }
  },
  "repository": "https://github.com/mozzius/expo-privacy-sensitive",
  "bugs": {
    "url": "https://github.com/mozzius/expo-privacy-sensitive/issues"
  },
  "author": "Samuel Newman <mozzius@protonmail.com> (https://github.com/mozzius)",
  "license": "MIT",
  "homepage": "https://github.com/mozzius/expo-privacy-sensitive#readme",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "expo": "^56.0.12",
    "expo-module-scripts": "^56.0.3",
    "react": "19.2.3",
    "react-native": "0.85.3"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
